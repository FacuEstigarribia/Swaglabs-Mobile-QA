<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite verbose="1" name="Swag Labs - iOS grid" parallel="false" thread-count="1">

    <!-- Selects src/main/resources/capabilities/ios.properties. -->
    <parameter name="platform" value="ios"/>

    <listeners>
        <listener class-name="com.mobile.swaglabs.qa.listener.ScreenshotOnFailureListener"/>
    </listeners>

    <!-- Product Grid feature only (SL-01..SL-04), for iterating without a full-suite cycle. -->
    <test name="Swag Labs iOS grid">
        <classes>
            <class name="com.mobile.swaglabs.qa.test.ProductGridTest"/>
        </classes>
    </test>
</suite>
