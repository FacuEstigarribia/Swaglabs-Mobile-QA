<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite verbose="1" name="Swag Labs - Android cart" parallel="false" thread-count="1">

    <!-- Selects src/main/resources/capabilities/android.properties. -->
    <parameter name="platform" value="android"/>

    <listeners>
        <listener class-name="com.mobile.swaglabs.qa.listener.ScreenshotOnFailureListener"/>
    </listeners>

    <!-- Cart cases only, for iterating on cart behaviour without a full-suite cycle. -->
    <test name="Swag Labs cart">
        <classes>
            <class name="com.mobile.swaglabs.qa.test.CartTest"/>
        </classes>
    </test>
</suite>
