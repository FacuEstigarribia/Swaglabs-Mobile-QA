<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite verbose="1" name="Swag Labs - iOS" parallel="false" thread-count="1"
       configfailurepolicy="continue">

    <!-- Selects src/main/resources/capabilities/ios.properties. -->
    <parameter name="platform" value="ios"/>

    <listeners>
        <listener class-name="com.mobile.swaglabs.qa.listener.ScreenshotOnFailureListener"/>
    </listeners>

    <test name="Swag Labs iOS">
        <classes>
            <class name="com.mobile.swaglabs.qa.test.ProductGridTest"/>
            <class name="com.mobile.swaglabs.qa.test.ProductFilterTest"/>
            <class name="com.mobile.swaglabs.qa.test.CartTest"/>
            <class name="com.mobile.swaglabs.qa.test.AccountTest"/>
            <class name="com.mobile.swaglabs.qa.test.LoginValidationTest"/>
        </classes>
    </test>
</suite>
