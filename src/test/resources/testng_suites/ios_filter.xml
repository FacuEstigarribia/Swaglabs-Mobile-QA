<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite verbose="1" name="Swag Labs - iOS filter" parallel="false" thread-count="1">

    <!-- Selects src/main/resources/capabilities/ios.properties. -->
    <parameter name="platform" value="ios"/>

    <listeners>
        <listener class-name="com.mobile.swaglabs.qa.listener.ScreenshotOnFailureListener"/>
    </listeners>

    <!-- Filtering feature only (SL-05..SL-08), for iterating without a full-suite cycle. -->
    <test name="Swag Labs iOS filter">
        <classes>
            <class name="com.mobile.swaglabs.qa.test.ProductFilterTest"/>
        </classes>
    </test>
</suite>
