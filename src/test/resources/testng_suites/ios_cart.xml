<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite verbose="1" name="Swag Labs - iOS cart" parallel="false" thread-count="1">

    <!-- Selects src/main/resources/capabilities/ios.properties. -->
    <parameter name="platform" value="ios"/>

    <listeners>
        <listener class-name="com.mobile.swaglabs.qa.listener.ScreenshotOnFailureListener"/>
    </listeners>

    <!-- Cart cases only, for iterating without a full iOS cycle (each session rebuilds WDA). -->
    <test name="Swag Labs iOS cart">
        <classes>
            <class name="com.mobile.swaglabs.qa.test.CartTest"/>
        </classes>
    </test>
</suite>
