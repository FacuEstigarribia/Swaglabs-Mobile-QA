<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite verbose="1" name="Swag Labs - Android grid" parallel="false" thread-count="1">

    <!-- Selects src/main/resources/capabilities/android.properties. -->
    <parameter name="platform" value="android"/>

    <!-- Zebrunner launcher metadata. Read by the repository scan, which generates one job
         per suite from it; it has no effect on a local `mvn test` run. See CLAUDE.md. -->
    <parameter name="suiteOwner" value="festigarribia"/>
    <parameter name="jenkinsJobName" value="Swaglabs-Android-Grid"/>
    <parameter name="jenkinsJobType" value="android"/>
    <parameter name="jenkinsEmail" value="festigarribia@solvd.com"/>
    <parameter name="jenkinsEnvironments" value="DEMO"/>

    <!-- Which farm serves the run, and the pool the device is leased from. `provider` also
         reaches the tests as -Dprovider, which is how SwagLabsBaseTest knows to skip
         capabilities/android-local.properties and leave this machine's emulator out of it. -->
    <parameter name="provider" value="mcloud"/>
    <parameter name="jenkinsMobileDefaultPool" value="ANY"/>

    <!-- Renders an editable field on the launcher. Empty by design: fill it in when starting
         a run, or leave it blank to test the build already installed on the leased device.
         An empty value is dropped rather than passed to Appium - see
         SwagLabsBaseTest.applyCommandLineOverrides. -->
    <parameter name="stringParam::capabilities.app::Swag Labs build to install (.apk); blank uses the build already on the device" value=""/>

    <listeners>
        <listener class-name="com.mobile.swaglabs.qa.listener.ScreenshotOnFailureListener"/>
    </listeners>

    <!-- Product Grid feature only (SL-01..SL-04), for iterating without a full-suite cycle. -->
    <test name="Swag Labs grid">
        <classes>
            <class name="com.mobile.swaglabs.qa.test.ProductGridTest"/>
        </classes>
    </test>
</suite>
