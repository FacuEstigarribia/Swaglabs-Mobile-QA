<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite verbose="1" name="Swag Labs - Android login" parallel="false" thread-count="1">

    <!-- Selects src/main/resources/capabilities/android.properties. -->
    <parameter name="platform" value="android"/>

    <listeners>
        <listener class-name="com.mobile.swaglabs.qa.listener.ScreenshotOnFailureListener"/>
    </listeners>

    <!-- Login feature only (SL-16..SL-17), for iterating without a full-suite cycle. -->
    <test name="Swag Labs login">
        <classes>
            <class name="com.mobile.swaglabs.qa.test.LoginValidationTest"/>
        </classes>
    </test>
</suite>
