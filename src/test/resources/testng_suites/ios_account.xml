<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite verbose="1" name="Swag Labs - iOS account" parallel="false" thread-count="1">

    <!-- Selects src/main/resources/capabilities/ios.properties. -->
    <parameter name="platform" value="ios"/>

    <listeners>
        <listener class-name="com.mobile.swaglabs.qa.listener.ScreenshotOnFailureListener"/>
    </listeners>

    <!-- Account feature only (SL-14..SL-15), for iterating without a full-suite cycle. -->
    <test name="Swag Labs iOS account">
        <classes>
            <class name="com.mobile.swaglabs.qa.test.AccountTest"/>
        </classes>
    </test>
</suite>
